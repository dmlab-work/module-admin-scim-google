{
    "name": "dmlab/module-admin-scim-google",
    "description": "Google Workspace (Cloud Identity) provider plugin for the admin-scim SCIM 2.0 server — adds the Google auto-provisioning setup panel (user provisioning only). Installing it pulls dmlab/module-admin-scim (and, transitively, sso-core).",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "scim",
        "scim 2.0",
        "provisioning",
        "deprovisioning",
        "offboarding",
        "google workspace",
        "cloud identity",
        "auto-provisioning",
        "admin users"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-scim-google",
    "license": "OSL-3.0",
    "version": "0.2.1",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-scim-google/issues",
        "source": "https://github.com/dmlab-work/module-admin-scim-google"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0.7",
        "magento/module-config": "^101.2.7",
        "dmlab/module-admin-scim": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminScimGoogle\\": ""
        }
    }
}
